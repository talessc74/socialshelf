# ─── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ─── Firebase ──────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── API Service ───────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# ─── Publisher Service ─────────────────────────────────────────────────────
PUBLISHER_PORT=3002
PUBLISHER_URL=http://localhost:3002

# ─── Generator Service ─────────────────────────────────────────────────────
GENERATOR_PORT=3003
GENERATOR_URL=http://localhost:3003

# ─── Google Gemini (Vertex AI) ─────────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
IMAGEN_MODEL=imagegeneration@006

# ─── Cloud Storage ─────────────────────────────────────────────────────────
GCS_BUCKET_UPLOADS=socialshelf-uploads
GCS_BUCKET_GENERATED=socialshelf-generated

# ─── OAuth — LinkedIn ──────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/linkedin/callback

# ─── OAuth — Instagram / Facebook ──────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/oauth/meta/callback

# ─── OAuth — X (Twitter) ───────────────────────────────────────────────────
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/oauth/twitter/callback

# ─── Session / CSRF ────────────────────────────────────────────────────────
CSRF_SECRET=change-this-to-a-random-64-char-hex-string

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
