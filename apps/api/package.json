    "@fastify/rate-limit": "^9.1.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@socialshelf/domain": "workspace:*",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@socialshelf/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
