rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    // Multi-tenant helpers
    function isMemberOfWorkspace(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function getWorkspaceMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    function hasRole(workspaceId, requiredRole) {
      let member = getWorkspaceMember(workspaceId);
      let roles = ['owner', 'editor', 'viewer'];
      let userRole = member.role;
      return roles.indexOf(userRole) <= roles.indexOf(requiredRole);
    }

    function canEdit(workspaceId) {
      return hasRole(workspaceId, 'editor');
    }

    function canManageMembers(workspaceId) {
      return hasRole(workspaceId, 'owner');
    }

    // ── Workspaces (multi-tenant) ─────────────────────────────────────
    match /workspaces/{workspaceId} {
      // Workspace metadata
      match /settings {
        allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
        allow write: if isAuthenticated() && canManageMembers(workspaceId);
      }

      // Workspace members
      match /members/{userId} {
        allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
        allow create: if isAuthenticated() && canManageMembers(workspaceId);
        allow update: if isAuthenticated() && canManageMembers(workspaceId);
        allow delete: if isAuthenticated() && canManageMembers(workspaceId);
      }

      // Audit logs
      match /audit_logs/{logId} {
        allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
        allow write: if false; // written only by backend services
      }

      // Brands
      match /brands/{brandId} {
        allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
        allow create: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
        allow update: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
        allow delete: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);

        // OAuth Connections
        match /oauth_connections/{connectionId} {
          allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
          allow write: if false; // written only by api-service
        }

        // Posts
        match /posts/{postId} {
          allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
          allow create: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
          allow update: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
          allow delete: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
        }

        // Generation Requests
        match /generation_requests/{requestId} {
          allow read: if isAuthenticated() && isMemberOfWorkspace(workspaceId);
          allow create: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
          allow update: if false; // updated only by generator-service
          allow delete: if isAuthenticated() && isMemberOfWorkspace(workspaceId) && canEdit(workspaceId);
        }
      }
    }

    // ── Users (compatibility: single-user accounts) ─────────────────────
    // Mantém compatibilidade durante transição para workspaces
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // AI consent sub-document
      match /ai_consent/{doc} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // Daily quota sub-document
      match /daily_quota/{date} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if false; // written only by backend services
      }

      // ── Brands ───────────────────────────────────────────────────────
      match /brands/{brandId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && request.resource.data.userId == userId;
        allow update: if isAuthenticated() && isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isAuthenticated() && isOwner(userId);

        // ── OAuth Connections ───────────────────────────────────────
        match /oauth_connections/{connectionId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow write: if false; // written only by api-service
        }

        // ── Posts ───────────────────────────────────────────────────
        match /posts/{postId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId)
            && request.resource.data.userId == userId
            && request.resource.data.brandId == brandId;
          allow update: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId);
        }

        // ── Generation Requests ─────────────────────────────────────
        match /generation_requests/{requestId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId);
          allow update: if false; // updated only by generator-service
          allow delete: if isAuthenticated() && isOwner(userId);
        }
      }
    }

    // ── Deny everything else ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
